PORT=5000
CLIENT_URL=http://127.0.0.1:5500
APP_URL=http://127.0.0.1:5500

DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskify
DB_USER=root
DB_PASSWORD=

# Set DB_SSL=true when connecting to a hosted MySQL provider (Aiven, etc.)
# that requires TLS — leave unset for a local MySQL install. DB_SSL_CA is
# optional: paste the provider's CA certificate (full PEM, including the
# BEGIN/END lines) for proper certificate verification; without it, the
# connection still encrypts but skips cert verification.
DB_SSL=false
DB_SSL_CA=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Comma-separated list of email domains allowed to register.
UNIVERSITY_EMAIL_DOMAIN=ump.ac.za,student.ump.ac.za

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Leave SMTP_HOST empty for dev mode (emails logged to console instead of sent).
# See EMAIL_SETUP.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Taskify <no-reply@taskify.local>"

TOTP_ISSUER=Taskify
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY=

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

EMAIL_VERIFICATION_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_MINUTES=30
TWOFA_PENDING_EXPIRY_MINUTES=5

# ── AI content moderation (tasks, sales, equipment, events + their images) ──
# Uses Azure AI Content Safety (F0 free tier — no credit card required
# under an Azure for Students subscription). Leave both empty to run
# without moderation (content publishes unchecked; a warning is logged
# once). See CONTENT_MODERATION_SETUP.md.
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
