{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "-l", "5501", "frontend"],
      "port": 5501
    },
    {
      "name": "backend-practice",
      "runtimeExecutable": "node",
      "runtimeArgs": ["backend/scripts/start-test-server.js"],
      "port": 5000
    },
    {
      "name": "backend-practice-alt",
      "runtimeExecutable": "node",
      "runtimeArgs": ["backend/scripts/start-test-server.js"],
      "env": { "PRACTICE_PORT": "5050" },
      "port": 5050
    },
    {
      "name": "explainer",
      "runtimeExecutable": "node",
      "runtimeArgs": ["explainer/tools/serve.mjs"],
      "port": 5502
    }
  ]
}
